{
  "ollama": {
    "base_url": "http://127.0.0.1:11434",
    "model": "llama3.1:8b",           
    "timeout_seconds": 120,
    "stream": false                    
  },

  "app": {
    "environment": "development",      
    "seed_sample_data": false,         
    "max_turns": 6,                    
    "max_field_len": 240              
  },

  "server": {
    "host": "127.0.0.1",
    "port": 5000,
    "allowed_origins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },

  "tools": {
    "enable_discovery": true,         
    "tool_packages": ["intelligence.tools"] 
  },

  "prompts": {
    "enable_narration": true,          
    "enable_adjudication": true,      
    "verbosity_default": "normal",   
    "dm_voice": {
      "tone": "neutral",             
      "persona": "classic_dm",         
      "sensory_focus": "balanced",     
      "consequence_level": "moderate" 
    }
  },

  "world": {
    "enable_world_guidance": true,     
    "default_modes": ["Clarify", "Expand", "Connect", "Challenge"]
  },

  "database": {
    "url": "sqlite:///./dnd.db",       
    "echo": false
  },

  "auth": {
    "local_dev_token": "dev",         
    "enable_auth": true                
  },

  "logging": {
    "level": "INFO",                
    "log_dir": "logs"                
  }
}
