# intelligence/tools/__init__.py
"""
Tool discovery helpers.

Tools are expected to live under intelligence.tools (a package) and expose:
- NAME: str
- run(args: str, context: dict) -> Any

ToolService (in services) will import and register tools dynamically. This module
keeps discovery logic minimal and testable.
"""

__all__ = ["discover_tools", "load_tool_module"]

import importlib
import logging
import pkgutil
import types
from typing import Callable, Dict, Optional

logger = logging.getLogger(__name__)
TOOLS_PACKAGE = "intelligence.tools"


def discover_tools(package: Optional[str] = None) -> Dict[str, Callable]:
    pkg_name = package or TOOLS_PACKAGE
    registry: Dict[str, Callable] = {}
    try:
        pkg = importlib.import_module(pkg_name)
    except Exception:
        logger.debug("No tools package found: %s", pkg_name)
        return registry

    for finder, modname, ispkg in pkgutil.iter_modules(pkg.__path__, pkg.__name__ + "."):
        try:
            mod = importlib.import_module(modname)
        except Exception:
            logger.exception("Failed to import tool module %s", modname)
            continue
        name = getattr(mod, "NAME", None)
        run_fn = getattr(mod, "run", None)
        if isinstance(name, str) and callable(run_fn):
            registry[name] = run_fn
    return registry


def load_tool_module(module_name: str) -> Optional[types.ModuleType]:
    try:
        return importlib.import_module(module_name)
    except Exception:
        logger.exception("Failed to import tool module %s", module_name)
        return None
